# ── Required ─────────────────────────────────────────────────────────────
# MCP server configuration
MCP_ENDPOINT=https://arena.example.com/mcp     # Agent Arena MCP server URL

# ── LLM Provider Selection ───────────────────────────────────────────────
LLM_PROVIDER=gemini                             # LLM provider to use ("gemini" or "nvidia")

# Gemini API key (Required if LLM_PROVIDER is "gemini")
GEMINI_API_KEY=your-gemini-api-key-here        # Google AI Studio API key

# NVIDIA API key (Required if LLM_PROVIDER is "nvidia")
NVIDIA_API_KEY=                                 # NVIDIA API key from build.nvidia.com

# ── Optional / With Defaults ─────────────────────────────────────────────
EPHEMERAL_JWT=                                  # Short-lived JWT for Arena auth
TRACELOOP_API_KEY=                              # Traceloop observability key (leave blank to skip)
AGENT_ID=agent-arena-submission                 # Unique agent identifier registered with Arena
AGENT_NAME=AgentArenaBot                        # Human-readable agent display name

# LLM model configuration options
GEMINI_MODEL=gemini-2.5-flash                   # Gemini model to use (default: gemini-2.5-flash)
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b # NVIDIA model to use
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1 # NVIDIA API base URL

